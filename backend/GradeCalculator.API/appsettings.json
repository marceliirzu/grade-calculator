{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Database": {
    "AutoMigrate": true
  },

  "Clerk": {
    "Authority": "SET_CLERK_AUTHORITY",
    "AuthorizedParties": [],
    "ClockSkewSeconds": 30
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Llm": {
    "ApiKey": "SET_LLM_API_KEY",
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "gpt-4o-mini",
    "MaxInputChars": 6000,
    "MaxOutputTokens": 700,
    "MaxAdvisorOutputTokens": 500,
    "MaxHistoryTurns": 8,
    "DailyTokenLimitPerUser": 40000,
    "TimeoutSeconds": 30,
    "MaxValidationRetries": 1
  }
}
