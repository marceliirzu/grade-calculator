{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "AutoMigrate": true
  },
  "Clerk": {
    "Authority": "SET_CLERK_AUTHORITY",
    "AuthorizedParties": [],
    "ClockSkewSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Llm": {
    "ApiKey": "SET_LLM_API_KEY",
    "Model": "claude-sonnet-5",
    "MaxInputChars": 6000,
    "MaxOutputTokens": 8000,
    "MaxAdvisorOutputTokens": 4000,
    "MaxHistoryTurns": 8,
    "DailyTokenLimitPerUser": 40000,
    "TimeoutSeconds": 120,
    "MaxValidationRetries": 1
  }
}
