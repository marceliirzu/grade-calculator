# Copy to .env.local for development, or set these in the GitHub Actions build environment.
# Everything here is inlined into the public bundle at build time — NEVER put a secret here.

# Base URL of the Railway API, including the /api suffix.
# Leave unset in development to use the Vite proxy at /api.
VITE_API_BASE_URL=https://your-app.up.railway.app/api

# Clerk publishable key (pk_test_... in development, pk_live_... in production).
# Publishable keys are safe to expose; the secret key belongs only in the backend.
# Find it under Clerk Dashboard -> API Keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Asset base path. Use "/" for a custom domain, or "/<repo-name>/" for a
# github.io project site. The deploy workflow sets this automatically.
VITE_BASE=/
